# Twilio
##secrart key 
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Target customer number (from the assignment)
TARGET_PHONE_NUMBER

# LLM (Groq — free tier, no card required, get key at console.groq.com)
GROQ_API_KEY=

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# WhatsApp (Meta Cloud API) — leave WHATSAPP_ENABLED=false until you set this up.
# When false, messages are printed to console instead of sent (stub mode).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO_NUMBER=

# Your info (used in the WhatsApp payload)
YOUR_MOBILE_NUMBE=
ARCHITECTURE_IMAGE_URL=

# Server
PUBLIC_BASE_URL=
##meta api key
